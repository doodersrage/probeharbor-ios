// Shared build settings. Values here ship inside the app.
// The site URL is public. Supabase URL and anon key are public too (the web
// app ships them), but they live in Secrets.xcconfig so forks can point at
// their own project without editing tracked files.

// xcconfig treats "//" as a comment, so URLs use $() to keep the slashes.
SLASH = /
PH_BASE_URL = https:$(SLASH)$(SLASH)probeharbor.dev
PH_SUPABASE_URL =
PH_SUPABASE_ANON_KEY =

#include? "Secrets.xcconfig"
